# Public Supabase project URL (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Publishable / anon key (Project Settings → API). Prefer sb_publishable_…
# Never put the service_role key in client code or NEXT_PUBLIC_* env vars.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Server only — Admin → Tenants → Create login (mobile + password).
# Supabase → Project Settings → API → service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=

# Global fallback rent UPI (used when a flat has no upi_id set)
# Per-flat override: Admin → Flats → Edit → Rent UPI ID / QR URL
NEXT_PUBLIC_RENT_UPI_ID=9492883721-2@ybl
NEXT_PUBLIC_RENT_UPI_NAME=Dendukuri's Residences

# Dedicated business WhatsApp for tenant reminders (+91 8867887061).
# 10-digit (8867887061) or E.164 (918867887061) both work — country code is added automatically.
WHATSAPP_BUSINESS_PHONE=918867887061

# Optional: Meta WhatsApp Cloud API — required for automatic (cron) sends
# from the business number. Without these, Send reminders opens WhatsApp drafts.
# Get token + phone number id from developers.facebook.com → WhatsApp → API setup.
# Phone number ID is the long numeric id on that page — not 8867887061.
# Use a System User token (temporary API-setup tokens expire in ~24 hours).
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Required for first-time / daily reminders. Create Utility templates in
# WhatsApp Manager, wait for APPROVED, then set the template names here.
# Dues body variables: {{1}} flat, {{2}} month, {{3}} total, {{4}} outstanding
# Terms body variables: {{1}} tenant, {{2}} flat, {{3}} rent
WHATSAPP_TEMPLATE_DUES=
WHATSAPP_TEMPLATE_TERMS=
WHATSAPP_TEMPLATE_LANG=en

# Vercel Cron auth for GET /api/cron/reminders (daily 9:00 AM IST).
# Vercel often injects CRON_SECRET; set it locally if you call the route yourself.
CRON_SECRET=
